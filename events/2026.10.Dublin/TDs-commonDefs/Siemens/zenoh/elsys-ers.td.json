{
  "@context": [
    "https://www.w3.org/ns/wot-next/td",
    {
      "lorav": "https://www.w3.org/2024/wot/lorawan#",
      "schema": "https://schema.org/",
      "brick": "https://brickschema.org/schema/Brick#",
      "knx": "http://schema.knx.org/2020/ontology/knx#",
      "qudt": "http://qudt.org/schema/qudt/",
      "qunit": "http://qudt.org/vocab/unit/",
      "quantitykind": "http://qudt.org/vocab/quantitykind/"
    }
  ],
  "@type": [
    "Thing",
    "brick:Sensor_Equipment"
  ],
  "id": "urn:dev:elsys_ers",
  "title": "elsys ers",
  "description": "ELSYS ERS multi-sensor: temperature, humidity, light, motion, CO2, and more over LoRaWAN.",
  "lorav:devEUI": "a81758fffe0eafe4",
  "lorav:joinEUI": "0000000000000000",
  "lorav:macVersion": "1.0.3",
  "schema:manufacturer": "ELSYS",
  "schema:mpn": "ERS",
  "lorav:region": "EU868",
  "lorav:frequencyPlan": "EU_863_870",
  "lorav:payloadLayout": "tlv",
  "lorav:tagFields": [
    {
      "name": "tag",
      "type": "u8"
    }
  ],
  "lorav:defaultEventingFrequencyMinutes": 10,
  "brick:hasLocation": {
    "@id": "urn:example:location:TTC_fair"
  },
  "events": {
    "temperature": {
      "data": {
        "type": "number",
        "unit": "°C"
      },
      "forms": [
        {
          "href": "zenoh+tcp://192.168.100.150:7447/application/d209ff97-929d-46f8-9180-ea2f6c382e90/device/a81758fffe0eafe4/event/up/temperature"
        }
      ]
    },
    "humidity": {
      "data": {
        "type": "integer",
        "unit": "%"
      },
      "forms": [
        {
          "href": "zenoh+tcp://192.168.100.150:7447/application/d209ff97-929d-46f8-9180-ea2f6c382e90/device/a81758fffe0eafe4/event/up/humidity"
        }
      ]
    },
    "co2": {
      "data": {
        "type": "integer",
        "unit": "ppm"
      },
      "forms": [
        {
          "href": "zenoh+tcp://192.168.100.150:7447/application/d209ff97-929d-46f8-9180-ea2f6c382e90/device/a81758fffe0eafe4/event/up/co2"
        }
      ]
    },
    "vdd": {
      "data": {
        "type": "integer",
        "unit": "mV"
      },
      "forms": [
        {
          "href": "zenoh+tcp://192.168.100.150:7447/application/d209ff97-929d-46f8-9180-ea2f6c382e90/device/a81758fffe0eafe4/event/up/vdd"
        }
      ]
    }
  },
  "properties": {},
  "formDefaults": {
    "additionalResponses": [],
    "contentType": "application/json",
    "op": "subscribeevent",
    "security": {
      "scheme": "apikey",
      "in": "uri",
      "name": "appKey",
      "description": "LoRaWAN OTAA AppKey (root key). Injected at runtime by the Servient; never stored in this TD."
    }
  }
}
