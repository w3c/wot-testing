{
  "@context" : [ "https://www.w3.org/2022/wot/td/v1.1", {
    "saref" : "https://w3id.org/saref#",
    "apt" : "https://example.org/apartment#",
    "mqv" : "http://www.example.org/mqtt-binding#",
    "cov" : "http://www.example.org/coap-binding#"
  } ],
  "id" : "urn:apartment:dishwasher-plug",
  "title" : "Dishwasher plug",
  "description" : "Smart plug of the dishwasher (1800 W, 120 min cycle). The appliance runs when it is loaded and the plug is on; switching the plug off pauses it until the plug is switched on again",
  "@type" : [ "saref:SmartPlug" ],
  "apt:room" : "kitchen",
  "apt:appliance" : "dishwasher",
  "securityDefinitions" : {
    "nosec_sc" : {
      "scheme" : "nosec"
    }
  },
  "security" : "nosec_sc",
  "properties" : {
    "on" : {
      "type" : "boolean",
      "description" : "The plug supplies power",
      "readOnly" : false,
      "observable" : true,
      "forms" : [ {
        "href" : "coap://localhost:5690/dishwasher-plug/properties/on",
        "op" : [ "readproperty", "writeproperty" ]
      }, {
        "href" : "coap://localhost:5690/dishwasher-plug/properties/on",
        "op" : [ "observeproperty", "unobserveproperty" ],
        "subprotocol" : "cov:observe"
      } ]
    },
    "power" : {
      "type" : "number",
      "minimum" : 0.0,
      "maximum" : 5000.0,
      "unit" : "W",
      "description" : "Power drawn",
      "readOnly" : true,
      "observable" : true,
      "forms" : [ {
        "href" : "coap://localhost:5690/dishwasher-plug/properties/power",
        "op" : [ "readproperty" ]
      }, {
        "href" : "coap://localhost:5690/dishwasher-plug/properties/power",
        "op" : [ "observeproperty", "unobserveproperty" ],
        "subprotocol" : "cov:observe"
      } ]
    },
    "appliance" : {
      "type" : "string",
      "enum" : [ "idle", "waiting", "running", "paused", "done" ],
      "description" : "The appliance's state",
      "readOnly" : true,
      "observable" : true,
      "forms" : [ {
        "href" : "coap://localhost:5690/dishwasher-plug/properties/appliance",
        "op" : [ "readproperty" ]
      }, {
        "href" : "coap://localhost:5690/dishwasher-plug/properties/appliance",
        "op" : [ "observeproperty", "unobserveproperty" ],
        "subprotocol" : "cov:observe"
      } ]
    },
    "remaining" : {
      "type" : "integer",
      "minimum" : 0,
      "description" : "Minutes of the cycle still to run",
      "readOnly" : true,
      "observable" : true,
      "forms" : [ {
        "href" : "coap://localhost:5690/dishwasher-plug/properties/remaining",
        "op" : [ "readproperty" ]
      }, {
        "href" : "coap://localhost:5690/dishwasher-plug/properties/remaining",
        "op" : [ "observeproperty", "unobserveproperty" ],
        "subprotocol" : "cov:observe"
      } ]
    }
  },
  "events" : {
    "applianceReady" : {
      "description" : "The appliance was loaded and is ready to run",
      "data" : {
        "type" : "object",
        "properties" : {
          "appliance" : {
            "type" : "string"
          },
          "time" : {
            "type" : "string"
          }
        }
      },
      "forms" : [ {
        "href" : "coap://localhost:5690/dishwasher-plug/events/applianceReady",
        "op" : [ "subscribeevent", "unsubscribeevent" ],
        "subprotocol" : "cov:observe"
      } ]
    },
    "cycleFinished" : {
      "description" : "The appliance finished its cycle",
      "data" : {
        "type" : "object",
        "properties" : {
          "appliance" : {
            "type" : "string"
          },
          "time" : {
            "type" : "string"
          }
        }
      },
      "forms" : [ {
        "href" : "coap://localhost:5690/dishwasher-plug/events/cycleFinished",
        "op" : [ "subscribeevent", "unsubscribeevent" ],
        "subprotocol" : "cov:observe"
      } ]
    }
  }
}
