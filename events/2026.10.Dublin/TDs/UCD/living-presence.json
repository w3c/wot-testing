{
  "@context" : [ "https://www.w3.org/2022/wot/td/v1.1", {
    "saref" : "https://w3id.org/saref#",
    "apt" : "https://example.org/apartment#",
    "mqv" : "http://www.example.org/mqtt-binding#",
    "cov" : "http://www.example.org/coap-binding#"
  } ],
  "id" : "urn:apartment:living-presence",
  "title" : "Living room presence sensor",
  "description" : "Whether anyone is in the living room, and how many people",
  "@type" : [ "saref:Sensor", "apt:PresenceSensor" ],
  "apt:room" : "living",
  "securityDefinitions" : {
    "nosec_sc" : {
      "scheme" : "nosec"
    }
  },
  "security" : "nosec_sc",
  "properties" : {
    "occupied" : {
      "type" : "boolean",
      "description" : "Someone is in the room",
      "readOnly" : true,
      "observable" : true,
      "forms" : [ {
        "href" : "mqtt://localhost:1890",
        "op" : [ "readproperty", "observeproperty", "unobserveproperty" ],
        "mqv:filter" : "apartment/living-presence/properties/occupied",
        "mqv:controlPacket" : "subscribe"
      } ]
    },
    "people" : {
      "type" : "integer",
      "minimum" : 0,
      "description" : "Number of people in the room",
      "readOnly" : true,
      "observable" : true,
      "forms" : [ {
        "href" : "mqtt://localhost:1890",
        "op" : [ "readproperty", "observeproperty", "unobserveproperty" ],
        "mqv:filter" : "apartment/living-presence/properties/people",
        "mqv:controlPacket" : "subscribe"
      } ]
    }
  }
}
